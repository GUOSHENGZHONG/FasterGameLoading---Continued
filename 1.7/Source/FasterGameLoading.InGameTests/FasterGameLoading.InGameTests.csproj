<Project Sdk="Microsoft.NET.Sdk">
  <!-- 僅供 RimWorld 1.7 開發測試；獨立輸出到附屬模組，不加入正式版方案。 -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FasterGameLoading.InGameTests</RootNamespace>
    <AssemblyName>FasterGameLoading.InGameTests</AssemblyName>
    <LangVersion>latest</LangVersion>
    <OutputPath>Mod\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>portable</DebugType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RepoRoot>$(MSBuildThisFileDirectory)..\..\..\</RepoRoot>
    <RimWorldDir>$(MSBuildThisFileDirectory)..\..\..\..\..\</RimWorldDir>
    <WorkshopDir>$(MSBuildThisFileDirectory)..\..\..\..\..\..\..\workshop\content\294100\</WorkshopDir>
    <DevToolsDll Condition="'$(DevToolsDll)' == ''">$(RepoRoot).test-temp\DevTools\_mod\1.7\Assemblies\DevTools.dll</DevToolsDll>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Krafs.Publicizer">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- 遊戲 DLL 不複製；DevTools 由下方開發輸出 target 單獨封裝。 -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldDir)Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldDir)UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>$(RimWorldDir)Waylith.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(WorkshopDir)2009463077\1.7\Assemblies\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="FasterGameLoading">
      <HintPath>..\..\Assemblies\FasterGameLoading.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DevTools">
      <HintPath>$(DevToolsDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Publicize Include="Assembly-CSharp" />
    <Publicize Include="FasterGameLoading" />
    <Publicize Include="DevTools" />
  </ItemGroup>
  <Target Name="CheckDevTools" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(DevToolsDll)')" Text="DevTools 1.7 DLL not found at $(DevToolsDll). Build pinned DevTools checkout or set -p:DevToolsDll=..." />
  </Target>
  <Target Name="CopyDevToolsForDevelopment" AfterTargets="Build">
    <Copy SourceFiles="$(DevToolsDll)" DestinationFiles="$(TargetDir)DevTools.dll" />
  </Target>
</Project>
