<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RimWorldDir>$(MSBuildThisFileDirectory)..\..\..\..\..\</RimWorldDir>
    <WorkshopDir>$(MSBuildThisFileDirectory)..\..\..\..\..\..\..\workshop\content\294100\</WorkshopDir>
    <RootNamespace>FasterGameLoading.Tests</RootNamespace>
    <AssemblyName>FasterGameLoading.Tests</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <NoWarn>NU1701;NU1702;SYSLIB0050;SYSLIB0012</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Meziantou.Analyzer">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FasterGameLoading.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\FasterGameLoading.InGameTests\StartupExperimentHelpers.cs" Link="StartupExperimentHelpers.cs" />
  </ItemGroup>

  <!-- 1.7 的遊戲組件與 Harmony 3.0 沒有 NuGet 套件：直接參考並複製到測試輸出，執行期才找得到。 -->
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(WorkshopDir)2009463077\1.7\Assemblies\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldDir)Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldDir)UnityStubs.dll</HintPath>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>$(RimWorldDir)Waylith.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
