<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RimWorldDir>$(MSBuildThisFileDirectory)..\..\..\..\..\</RimWorldDir>
    <WorkshopDir>$(MSBuildThisFileDirectory)..\..\..\..\..\..\..\workshop\content\294100\</WorkshopDir>
    <RootNamespace>FasterGameLoading.Tests</RootNamespace>
    <AssemblyName>FasterGameLoading.Tests</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <NoWarn>NU1701;NU1702;SYSLIB0050;SYSLIB0012</NoWarn>
    <!-- 以 Microsoft.Testing.Platform 執行測試：NUnit3TestAdapter 6.x 以此屬性改用 MTP 模式。
         MTP 會先執行測試組件的進入點，再進行探索，讓 TestSetup 的 module initializer
         有機會註冊組件解析器；VSTest 模式則在探索階段直接反射組件，導致 RimWorld
         managed 組件尚未能解析而找不到任何測試。 -->
    <EnableNUnitRunner>true</EnableNUnitRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Meziantou.Analyzer">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FasterGameLoading.csproj" />
  </ItemGroup>

  <!-- 將 RimWorld 安裝目錄嵌入組件 metadata，讓 TestSetup 的組件解析器在未設定
       RIMWORLD_MANAGED_DIR 環境變數時仍能找到遊戲 managed 組件（Assembly-CSharp.dll 等）。 -->
  <ItemGroup>
    <AssemblyMetadata Include="RimWorldDir" Value="$(RimWorldDir)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\FasterGameLoading.InGameTests\StartupExperimentHelpers.cs" Link="StartupExperimentHelpers.cs" />
  </ItemGroup>

  <!-- 1.7 的遊戲組件與 Harmony 3.0 沒有 NuGet 套件：直接參考並複製到測試輸出，執行期才找得到。 -->
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(WorkshopDir)2009463077\1.7\Assemblies\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldDir)Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldDir)UnityStubs.dll</HintPath>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>$(RimWorldDir)Waylith.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
